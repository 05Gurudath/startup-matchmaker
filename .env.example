# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# ---- MySQL ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=startup_matchmaker

# ---- Authentication ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me

# ---- OCR ----
# Optional. Full path to the Tesseract executable if it is not on your PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=

# ---- CORS ----
# Optional. Comma-separated list of frontend origins allowed to call the API.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
